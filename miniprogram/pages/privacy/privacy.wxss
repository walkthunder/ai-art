/* 隐私政策页面样式 */
@import "../../styles/common-navigation.wxss";

.privacy-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
}

.privacy-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, 
    rgba(255, 248, 220, 0.9) 0%, 
    rgba(255, 240, 204, 0.95) 100%
  );
  z-index: 0;
  pointer-events: none;
}

.privacy-content {
  position: relative;
  z-index: 10;
  padding: 24rpx 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.content-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 auto;
  max-width: 650rpx;
}

.update-time {
  font-size: 22rpx;
  color: #999999;
  text-align: right;
  margin-bottom: 24rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #8B4513;
  margin-bottom: 16rpx;
}

.section-text {
  display: block;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.list-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  padding-left: 16rpx;
}

.bullet {
  font-size: 26rpx;
  color: var(--color-festival-gold);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.list-text {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

/* 老年模式适配 */
.elder-mode .section-title {
  font-size: 34rpx;
}

.elder-mode .section-text,
.elder-mode .list-text {
  font-size: 30rpx;
}

.elder-mode .update-time {
  font-size: 26rpx;
}

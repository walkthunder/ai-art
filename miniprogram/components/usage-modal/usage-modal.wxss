/* 使用次数模态框样式 */

.usage-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: none;
}

.usage-modal.show {
  display: block;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  animation: fadeIn 0.3s ease;
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 620rpx;
  max-width: 90%;
  max-height: 85vh;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  animation: slideUp 0.3s ease;
  overflow-y: auto;
}

.modal-body {
  padding: 48rpx 40rpx;
  text-align: center;
}

.modal-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.modal-tips {
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  text-align: left;
}

.modal-tips text {
  display: block;
  font-size: 26rpx;
  color: #8B4513;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.modal-tips text:last-child {
  margin-bottom: 0;
}

/* 付费套餐优势列表 */
.modal-benefits {
  background: linear-gradient(135deg, #F8F9FA 0%, #FFFFFF 100%);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 32rpx;
  text-align: left;
  border: 2rpx solid #E8EAED;
}

.benefits-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
  text-align: center;
}

.benefit-section {
  margin-bottom: 20rpx;
}

.benefit-section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #555555;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
  border-left: 4rpx solid #FF6B6B;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
  padding-left: 12rpx;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.benefit-icon {
  font-size: 24rpx;
  color: #4CAF50;
  margin-right: 12rpx;
  font-weight: bold;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.benefit-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  flex: 1;
}

/* 套餐选项列表 */
.modal-packages {
  background: transparent;
  border-radius: 16rpx;
  padding: 0;
  margin-bottom: 32rpx;
  text-align: left;
}

.package-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  text-align: center;
}

.package-item {
  position: relative;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #E8EAED;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.package-item:last-child {
  margin-bottom: 0;
}

.package-item.highlight {
  border-color: #FF6B6B;
  background: linear-gradient(135deg, #FFF8F8 0%, #FFFFFF 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.15);
}

.package-badge {
  position: absolute;
  top: -8rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF4757 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(255, 107, 107, 0.3);
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.package-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.package-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.package-features {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-item {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  padding-left: 8rpx;
}

.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.modal-tip {
  background: #FFF8F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.modal-tip text {
  font-size: 24rpx;
  color: #FF8C00;
  line-height: 1.6;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  padding: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF4757 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 107, 0.3);
}

.btn-secondary {
  background: #F5F5F5;
  color: #666666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}

.modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999999;
  cursor: pointer;
}

/* 老年模式样式 */
.modal-content.elder-mode {
  width: 660rpx;
}

.modal-content.elder-mode .modal-body {
  padding: 56rpx 48rpx;
}

.modal-content.elder-mode .modal-icon {
  font-size: 120rpx;
}

.modal-content.elder-mode .modal-title {
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.modal-content.elder-mode .modal-desc {
  font-size: 32rpx;
  margin-bottom: 40rpx;
}

.modal-content.elder-mode .modal-tips {
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.modal-content.elder-mode .modal-tips text {
  font-size: 30rpx;
  line-height: 2;
  margin-bottom: 12rpx;
}

.modal-content.elder-mode .benefits-title {
  font-size: 34rpx;
}

.modal-content.elder-mode .section-title {
  font-size: 30rpx;
}

.modal-content.elder-mode .benefit-text {
  font-size: 30rpx;
}

.modal-content.elder-mode .package-title {
  font-size: 34rpx;
}

.modal-content.elder-mode .package-name {
  font-size: 34rpx;
}

.modal-content.elder-mode .package-price {
  font-size: 40rpx;
}

.modal-content.elder-mode .feature-item {
  font-size: 28rpx;
}

.modal-content.elder-mode .modal-tip text {
  font-size: 28rpx;
}

.modal-content.elder-mode .btn {
  height: 100rpx;
  line-height: 100rpx;
  font-size: 36rpx;
}

.modal-content.elder-mode .modal-close {
  width: 64rpx;
  height: 64rpx;
  font-size: 48rpx;
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translate(-50%, -40%);
    opacity: 0;
  }
  to {
    transform: translate(-50%, -50%);
    opacity: 1;
  }
}

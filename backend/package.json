{
  "name": "volcengine-api-proxy",
  "version": "1.0.0",
  "description": "Proxy service for Volcengine API calls",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check-deps": "node scripts/check-dependencies.js",
    "install-ffmpeg": "bash scripts/install-ffmpeg.sh",
    "db:init": "node scripts/init-database.js",
    "db:verify": "node scripts/verify-database.js",
    "db:migrate": "node db/migrate.js",
    "db:migrate:status": "node db/migrate.js status",
    "migrate": "node scripts/run-migrations.js",
    "usage:init": "node scripts/init-usage-system.js",
    "usage:verify-indexes": "node scripts/verify-indexes.js",
    "usage:reset": "node scripts/reset-usage-count.js",
    "usage:list": "node scripts/reset-usage-count.js --list",
    "db:cloudbase": "node db/sync-cloudbase.js",
    "db:cloudbase:sql": "node db/sync-cloudbase.js sql",
    "db:test": "node -e \"require('./db/connection').testConnection().then(() => process.exit(0)).catch(() => process.exit(1))\"",
    "test:api": "node scripts/test-apis.js",
    "test:caishen-api": "node test-caishen-api.js",
    "test:e2e": "node test-e2e.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.16.0",
    "@volcengine/openapi": "^1.32.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cos-nodejs-sdk-v5": "^2.11.19",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.15.3",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "uuid": "^9.0.0",
    "wechatpay-node-v3": "^2.2.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "fast-check": "^4.5.3",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
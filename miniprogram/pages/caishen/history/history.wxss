/**
 * 财神变身历史记录页样式
 * Requirements: 4.6
 */

@import '/styles/common-navigation.wxss';

.caishen-history-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #8B0000 0%, #6B0000 50%, #4B0000 100%);
  display: flex;
  flex-direction: column;
}

/* 背景图片 */
.history-bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 内容区域 */
.history-content {
  position: fixed;
  width: 100%;
  bottom: 0;
  z-index: 10;
  box-sizing: border-box;
  overflow-y: auto;
  padding: 32rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #FFD700;
  margin-top: 16rpx;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.error-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 32rpx;
}

.retry-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  border-radius: 48rpx;
}

.retry-text {
  font-size: 28rpx;
  color: #8B0000;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 32rpx;
}

.create-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  border-radius: 48rpx;
}

.create-text {
  font-size: 28rpx;
  color: #8B0000;
  font-weight: bold;
}

/* 记录网格 */
.record-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.record-item {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 215, 0, 0.2);
}

.record-item.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 视频缩略图容器 */
.record-video-wrapper {
  position: relative;
  width: 100%;
  padding-top: 133.33%; /* 3:4 比例 */
  background: rgba(0, 0, 0, 0.5);
}

.record-thumbnail {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.record-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
}

.placeholder-icon {
  font-size: 64rpx;
  opacity: 0.5;
}

/* 播放图标 */
.play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
}

.play-text {
  font-size: 32rpx;
  color: #FFD700;
  margin-left: 4rpx;
}

/* 状态标识 */
.status-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(4px);
}

.status-completed {
  background: rgba(16, 185, 129, 0.8);
}

.status-processing {
  background: rgba(59, 130, 246, 0.8);
}

.status-pending {
  background: rgba(251, 191, 36, 0.8);
}

.status-failed {
  background: rgba(239, 68, 68, 0.8);
}

.status-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 删除按钮 */
.delete-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
}

.delete-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 记录信息 */
.record-info {
  padding: 16rpx;
  text-align: center;
}

.record-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 老年模式适配 */
.elder-mode .nav-title {
  font-size: 42rpx;
}

.elder-mode .loading-text,
.elder-mode .error-text,
.elder-mode .empty-text,
.elder-mode .create-text,
.elder-mode .retry-text {
  font-size: 32rpx;
}

.elder-mode .record-date {
  font-size: 28rpx;
}

.elder-mode .status-text {
  font-size: 24rpx;
}

.upload-container {
  min-height: 100vh;
  background-size: cover;
  background-position: center;
  background-color: #FFF8F0;
}

.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: linear-gradient(180deg, rgba(139, 0, 0, 0.95) 0%, rgba(139, 0, 0, 0.8) 100%);
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  padding: 0 16rpx;
}

.back-button {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #FFD700;
  font-weight: bold;
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #FFD700;
}

.navbar-right {
  width: 80rpx;
}

.content-wrapper {
  padding: 180rpx 40rpx 40rpx;
}

.upload-tip {
  background: rgba(255, 215, 0, 0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid #FFD700;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #8B0000;
  line-height: 1.5;
}

.upload-area {
  margin-bottom: 40rpx;
}

.image-box {
  width: 100%;
  height: 600rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background: rgba(255, 255, 255, 0.9);
  border: 4rpx dashed #D4AF37;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.camera-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #999;
}

.remove-button {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  font-size: 48rpx;
  color: #FFF;
  line-height: 1;
}

.error-message {
  background: #FFE4E1;
  color: #D32F2F;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  text-align: center;
}

.processing-status {
  margin-bottom: 24rpx;
}

.status-text {
  font-size: 28rpx;
  color: #8B0000;
  text-align: center;
  margin-bottom: 16rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(212, 175, 55, 0.2);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4AF37 0%, #FFD700 100%);
  transition: width 0.3s ease;
}

.generate-button {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 100%);
  color: #8B0000;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(212, 175, 55, 0.4);
}

.generate-button.disabled {
  background: #CCC;
  color: #999;
  box-shadow: none;
}
